# Customer Account ID Search

# List of customer account IDs
ids = [10, 20, 30, 40, 50]

# Input account ID
key = int(input("Enter customer account ID: "))

# Linear Search
found = False
for i in range(len(ids)):
    if ids[i] == key:
        print("Linear Search: ID found at position", i + 1)
        found = True
        break

if not found:
    print("Linear Search: ID not found")

# Binary Search
low = 0
high = len(ids) - 1
found = False

while low <= high:
    mid = (low + high) // 2

    if ids[mid] == key:
        print("Binary Search: ID found at position", mid + 1)
        found = True
        break
    elif ids[mid] < key:
        low = mid + 1
    else:
        high = mid - 1

if not found:
    print("Binary Search: ID not found")
