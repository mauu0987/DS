
size = 10
table = [-1] * size

def insert(key):
    i = key % size
    while table[i] != -1:
        i = (i + 1) % size
    table[i] = key
    print("Inserted")

def search(key):
    i = key % size
    for j in range(size):
        if table[i] == key:
            print("Found")
            return
        i = (i + 1) % size
    print("Not found")

def delete(key):
    i = key % size
    for j in range(size):
        if table[i] == key:
            table[i] = -2
            print("Deleted")
            return
        if table[i] == -1:
            break
        i = (i + 1) % size
    print("Not found")

def display():
    print(table)

while True:
    print("\n1.Insert 2.Search 3.Delete 4.Display 5.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        insert(int(input("Enter key: ")))
    elif ch == 2:
        search(int(input("Enter key: ")))
    elif ch == 3:
        delete(int(input("Enter key: ")))
    elif ch == 4:
        display()
    elif ch == 5:
        break
