# Hash Table using Chaining

size = 10
table = [[] for i in range(size)]

# Insert
def insert(key, value):
    index = key % size
    table[index].append((key, value))
    print("Inserted")

# Search
def search(key):
    index = key % size
    for k, v in table[index]:
        if k == key:
            print("Value:", v)
            return
    print("Key not found")

# Delete
def delete(key):
    index = key % size
    for item in table[index]:
        if item[0] == key:
            table[index].remove(item)
            print("Deleted")
            return
    print("Key not found")

# Display
def display():
    for i in range(size):
        print(i, ":", table[i])

while True:
    print("\n1.Insert  2.Search  3.Delete  4.Display  5.Exit")
    ch = int(input("Enter choice: "))

    if ch == 1:
        key = int(input("Enter key: "))
        value = input("Enter value: ")
        insert(key, value)

    elif ch == 2:
        key = int(input("Enter key: "))
        search(key)

    elif ch == 3:
        key = int(input("Enter key: "))
        delete(key)

    elif ch == 4:
        display()

    elif ch == 5:
        break

    else:
        print("Invalid choice")
