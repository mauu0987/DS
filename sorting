# Employee Salary Sorting

salaries = [25000.5, 45000.0, 30000.5, 60000.0, 50000.0, 35000.0]

# Selection Sort
a = salaries.copy()
for i in range(len(a)):
    min_idx = i
    for j in range(i + 1, len(a)):
        if a[j] < a[min_idx]:
            min_idx = j
    a[i], a[min_idx] = a[min_idx], a[i]

print("Selection Sort:", a)
print("Top 5 Highest Salaries:", a[-5:][::-1])

# Bubble Sort
b = salaries.copy()
for i in range(len(b)):
    for j in range(len(b) - i - 1):
        if b[j] > b[j + 1]:
            b[j], b[j + 1] = b[j + 1], b[j]

print("Bubble Sort:", b)
print("Top 5 Highest Salaries:", b[-5:][::-1])
